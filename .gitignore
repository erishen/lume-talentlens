# node (frontend is pnpm-managed; node_modules holds the pnpm virtual store)
frontend/node_modules
www/github/app.js

# runtime logs
.lume-*.log
.lume-github.log
logs/

# generated snapshot (regenerate via `make fetch`)
data/github/
# scratch written by tests (e.g. tests/history_guard.lume -> data/.tmp/)
data/.tmp/

# python bytecode caches (scripts/*.py); not every machine has a global ignore
__pycache__/
*.pyc

# local dev
.env
*.swp
.DS_Store

# framework session store (agent chat transcripts)
.data/
