// lib/trending.lume — GitHub trending projects (/api/trending).
//
// GitHub has no official "trending" API, so for the GLOBAL feed this route
// scrapes github.com/trending itself (lib/trending_html.lume) — the exact list,
// order and star counts the page shows. When the page cannot be parsed (markup
// change, network) it falls back to the Search API (repos *created* within the
// window, sorted by stars) so the tab never goes blank. The fetch is issued
// server-side via the shared gh_get() (same outbound path as the live proxy), so
// the browser needs no route to github.com and GH_TOKEN can still be injected
// for the Search-API fallback (30 req/min authenticated vs 10 anon).
//
//   GET /api/trending?since=daily|weekly|monthly&lang=<language>&tr=zh&owner=<login>&refresh=1
//     -> { ok, scope, owner, since, lang, days, generated_at, count, source, items: [ … ] }
//     -> { ok: false, status, err } when GitHub is unreachable / rate-limited
//
// `owner=<login>` narrows to ONE account's own NEW repositories
// (`user:<login> created:>window`, sorted by stars) and always uses the Search
// API — github.com/trending has no owner scope. Likewise languages with no
// trending slug (C++, C#) fall back to the Search API. `source` reports which
// path produced the items ("github-trending" | "github-search").
//
// Responses are TTL-cached in memory (TRENDING_CACHE_TTL_SEC, default 120s) and
// on disk (TRENDING_DISK_TTL_SEC, default 600s); 0 disables either. Because
// github.com/trending reorders every few minutes, `refresh=1` bypasses both
// tiers to fetch fresh (used by the UI refresh button and make trending-push);
// the fresh result still repopulates the cache.
//
// &tr=zh requests machine translation of the repo descriptions: the items gain
// a `desc_zh` field (the English `desc` is kept). Translation goes through the
// local OpenAI-compatible gateway (LLM_API_URL / LLM_MODEL); the key is read
// from LLM_ANALYZER_KEY because env() masks LLM_API_KEY. It is best-effort and
// memoised per description — see trending_translate_items() below.

import "shared.lume" as sh;
import "trending_html.lume" as th;

// language qualifier: GitHub language names are plain ([A-Za-z0-9+#-.] for
// "C++" / "C#" / ".NET"…). Anything else is rejected before the URL is built.
let _TRENDING_LANG_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+#.-";

// null-safe stringify for fields that may be null in the raw API payload.
func s(v) {
  if (v == null) { return ""; }
  return str(v);
}

func trending_ttl() {
  let v = env("TRENDING_CACHE_TTL_SEC");
  if (v == null) { return 120; }
  let n = int(v, 120);
  if (n < 0) { return 0; }
  return n;
}

func trending_valid_lang(x) {
  let n = len(x);
  if (n == 0 or n > 30) { return false; }
  let i = 0;
  while (i < n) {
    if (not sh.contains(_TRENDING_LANG_CHARS, substr(x, i, 1))) { return false; }
    i = i + 1;
  }
  return true;
}

// github.com/trending path slug for a language ("Python" -> "python",
// "Jupyter Notebook" -> "jupyter-notebook"). Returns "" for languages with no
// usable path slug (e.g. "C++", "C#") so the caller falls back to the Search API
// rather than requesting a trending page that does not exist.
export func trending_lang_slug(lang) {
  let l = sh.lower(lang);
  l = replace(l, " ", "-");
  let i = 0;
  while (i < len(l)) {
    if (not sh.contains("abcdefghijklmnopqrstuvwxyz0123456789-", substr(l, i, 1))) { return ""; }
    i = i + 1;
  }
  return l;
}

// the github.com/trending URL for a window (+ optional language slug).
export func trending_scrape_url(since, slug) {
  let base = "https://github.com/trending";
  if (slug != "") { base = base + "/" + slug; }
  return base + "?since=" + since;
}

// window -> how many days back the `created:>` cutoff reaches
func trending_days(since) {
  return sh.search_days(since);
}

// Build the Search API `q` value for a window, optional language and optional
// owner scope. Split out (and exported) so tests/trending_guard.lume can assert
// the PRIVACY-CRITICAL invariants: every query carries `is:public` (the search
// runs with the server token, which can otherwise see the token owner's private
// repos — worst under user:<login>), and owner scope is expressed as user:<login>.
export func trending_query(since, lang, owner_login) {
  let q = sh.search_created_qualifier(trending_days(since)) + " is:public";
  if (owner_login != "") { q = "user:" + owner_login + " " + q; }
  if (lang != "") { q = q + " language:" + lang; }
  return q;
}

func trending_enc(x) {
  return sh.search_enc(x);
}

// ------------------------------------------------ description translation
// The trending feed is English-first; when the UI is Chinese we machine-
// translate the descriptions so the list reads in the user's language. The
// gateway is the same local OpenAI-compatible endpoint the agent uses, but we
// call it directly with http_post (allow_private: the router is loopback).
//
// Best-effort and memoised:
//   * no config / bad response -> descriptions stay English (UI falls back);
//   * a failed batch trips a short backoff so a dead gateway is not re-hit on
//     every request (the request would otherwise hang on the 30s timeout);
//   * results are cached per English description, so switching windows or
//     re-viewing the tab never re-translates the same string.
let _tr_state = { fail_until: 0, cache: {} };

func trending_strip_fences(x) {
  x = replace(x, "```json", "");
  x = replace(x, "```", "");
  return x;
}

// ---- translation memo, disk-persisted -----------------------------------
// The in-memory `_tr_state.cache` is per-worker (prefork) and lost on
// restart. Descriptions churn slowly, so persisting the English->zh memo to
// disk means any worker (and any restart) reuses past translations instead of
// re-paying the LLM round-trip. TTL is TR_DISK_TTL_SEC (default 7d; 0
// disables the disk tier). Writes MERGE into the on-disk map so concurrent
// workers never clobber each other's entries; the map is capped.
func tr_disk_ttl() {
  let v = env("TR_DISK_TTL_SEC");
  if (v == null) { return 604800; }
  let n = int(v, 604800);
  if (n < 0) { return 0; }
  return n;
}

func tr_disk_file() {
  return "data/github/trending/zh_cache.json";
}

// translation retry policy (TR_TRANSLATE_RETRIES default 3 / TR_TRANSLATE_TIMEOUT
// default 20s): the local LLM gateway intermittently stalls or 502s from a
// slow/broken upstream provider, so each batch POST is retried — see
// trending_translate_items(). Free/flash upstreams answer a small chunk in
// ~5–10s but can cold-start near ~30s, hence the generous per-attempt timeout.
func tr_translate_retries() {
  let v = env("TR_TRANSLATE_RETRIES");
  if (v == null) { return 3; }
  let n = int(v, 3);
  if (n < 1) { return 1; }
  return n;
}
func tr_translate_timeout() {
  let v = env("TR_TRANSLATE_TIMEOUT");
  if (v == null) { return 20; }
  let n = int(v, 20);
  if (n < 3) { return 3; }
  return n;
}
// TR_TRANSLATE_BATCH (default 6): descriptions per gateway call. A single call
// carrying every missing description is slow and some upstreams reject a large
// JSON array outright, so the work is split into small chunks that each finish
// inside tr_translate_timeout() even on a free/flash model.
func tr_translate_batch_size() {
  let v = env("TR_TRANSLATE_BATCH");
  if (v == null) { return 6; }
  let n = int(v, 6);
  if (n < 1) { return 1; }
  return n;
}

export func tr_disk_load() {
  if (tr_disk_ttl() <= 0) { return {}; }
  let raw = read_file(tr_disk_file());
  if (raw == null or raw == "") { return {}; }
  let d = sh.safe_json(raw);
  if (d == null) { return {}; }
  if ((int(now(), 0) - int(get(d, "at", 0), 0)) >= tr_disk_ttl()) { return {}; }
  let c = get(d, "cache", null);
  if (c == null) { return {}; }
  return c;
}

export func tr_disk_save(new_entries) {
  if (tr_disk_ttl() <= 0) { return; }
  if (len(new_entries) == 0) { return; }
  mkdir("data/github/trending");
  // merge on top of what is on disk now (other workers may have written more)
  let d = sh.safe_json(read_file(tr_disk_file()));
  let cache = {};
  if (d != null) {
    let existing = get(d, "cache", null);
    if (existing != null) { cache = existing; }
  }
  for (let k in new_entries) { put(cache, k, str(get(new_entries, k, ""))); }
  if (len(cache) > 5000) {
    // cap: drop the whole map (cheap, bounded) rather than tracking LRU
    cache = new_entries;
  }
  let payload = str({ at: int(now(), 0), cache: cache });
  write_file(tr_disk_file(), payload);
}

// Decide whether a just-translated zh response is safe to cache. It is NOT
// when a *configured* gateway had missing work and translated none of it:
// caching that would serve an English-only payload as `tr=zh` for the whole
// TTL (memory 600s + disk 3600s), so a transient upstream outage would hide
// the 机翻 for an hour even after the gateway recovered. Unconfigured gateway
// or nothing-missing are always safe (nothing will change).
export func tr_cacheable(configured, need_count, any_ok) {
  if (not configured) { return true; }
  if (need_count == 0) { return true; }
  return any_ok;
}

// Translate descriptions in place (adds desc_zh). Returns true when the caller
// may cache the response — see tr_cacheable().
func trending_translate_items(items) {
  let url = env("LLM_API_URL");
  let key = env("LLM_ANALYZER_KEY");
  let configured = true;
  if (url == null or str(url) == "" or key == null or str(key) == "") { configured = false; }
  if (not configured) { return true; }

  let cache = get(_tr_state, "cache", {});
  // backfill from disk: any description another worker (or a previous run)
  // already translated is treated as done, so it never re-enters the batch.
  let disk = tr_disk_load();
  for (let k in disk) {
    if (get(cache, k, null) == null) { put(cache, k, str(get(disk, k, ""))); }
  }
  // collect the unique, non-empty descriptions still missing a translation
  let need = [];
  let seen = {};
  for (let it in items) {
    let d = str(get(it, "desc", ""));
    if (d == "" or get(cache, d, null) != null or get(seen, d, null) != null) { continue; }
    put(seen, d, true);
    push(need, d);
  }
  let any_ok = false;
  // hit the gateway only when there is missing work AND we are not backing
  // off; a cached translation is still attached below even during a backoff,
  // so one dead gateway never blanks out already-known Chinese descriptions.
  if (len(need) > 0 and int(now(), 0) >= int(get(_tr_state, "fail_until", 0), 0)) {
    let model = env("LLM_MODEL");
    if (model == null or str(model) == "") { model = "auto"; }
    let sys = "You translate GitHub repository descriptions into Simplified Chinese. "
      + "Preserve technical terms, library/product names and code identifiers. "
      + "Reply with ONLY a JSON array of strings — same length and order as the "
      + "input, no prose and no code fences.";
    // X-Llm-Router-Agent: off — skip the gateway's agent/fastpath path so the
    // chunk is proxied straight to the tr-zh route (the codegen fastpath would
    // otherwise "solve" the batch and replay a stale, wrong-length answer).
    let headers = { "Content-Type": "application/json", "Authorization": "Bearer " + str(key), "X-Llm-Router-Agent": "off" };
    // split `need` into small chunks: one call carrying all descriptions is slow
    // and some upstreams reject a large array, so translate a few at a time.
    let bs = tr_translate_batch_size();
    let chunks = [];
    let cur = [];
    for (let d in need) {
      push(cur, d);
      if (len(cur) >= bs) { push(chunks, cur); cur = []; }
    }
    if (len(cur) > 0) { push(chunks, cur); }
    let new_entries = {};
    // consecutive all-retry-failed chunks before we treat the gateway as down.
    // A single bad upstream (the tr-zh route fails over between providers and
    // 502s ~1/3 of the time) must NOT abort the remaining chunks — that used to
    // zero the whole batch on one unlucky first chunk.
    let fail_streak = 0;
    for (let chunk in chunks) {
      if (fail_streak >= 2) { break; }
      let got = {};
      let done = false;
      let attempt = 0;
      while (attempt < tr_translate_retries() and not done) {
        attempt = attempt + 1;
        let payload = {
          model: str(model),
          stream: false,
          temperature: 0,
          messages: [
            { role: "system", content: sys },
            { role: "user", content: str(chunk) },
          ],
        };
        let r = http_post(str(url), {
          headers: headers,
          body: str(payload),
          timeout: tr_translate_timeout(),
          max_bytes: 262144,
          allow_private: true,
        });
        let up = int(get(r, "status", 0), 0);
        let resp = sh.safe_json(get(r, "body", ""));
        if (up >= 200 and up < 300 and resp != null) {
          let ch = get(resp, "choices", []);
          if (len(ch) > 0) {
            let content = str(get(get(ch[0], "message", {}), "content", ""));
            let arr = sh.safe_json(trending_strip_fences(content));
            if (arr != null) {
              // map positionally: arr[i] is the translation of chunk[i]
              let n = len(chunk);
              let m = len(arr);
              let i = 0;
              while (i < n and i < m) {
                let zh = str(arr[i]);
                if (zh != "" and zh != "null") { put(got, chunk[i], zh); }
                i = i + 1;
              }
              done = true;
            }
          }
        }
      }
      if (len(got) == 0) {
        // this chunk exhausted every retry — count it, but only give up on the
        // gateway after two in a row (the loop's fail_streak guard).
        fail_streak = fail_streak + 1;
      } else {
        fail_streak = 0;
        any_ok = true;
        for (let k in got) {
          put(cache, k, str(get(got, k, "")));
          put(new_entries, k, str(get(got, k, "")));
        }
      }
    }
    if (any_ok) {
      // persist across workers/restarts (merged on disk)
      tr_disk_save(new_entries);
    } else {
      // nothing translated at all — avoid re-hitting a dead gateway on every
      // request; cached translations still attach below.
      put(_tr_state, "fail_until", int(now(), 0) + 120);
    }
  }
  // bound the memo: descriptions churn, so drop it wholesale past a cap
  if (len(cache) > 2000) { put(_tr_state, "cache", {}); cache = get(_tr_state, "cache", {}); }

  // attach the translation (when we have one) without dropping the original
  for (let it in items) {
    let zh = get(cache, str(get(it, "desc", "")), null);
    if (zh != null and str(zh) != "") { put(it, "desc_zh", str(zh)); }
  }
  return tr_cacheable(configured, len(need), any_ok);
}

let _trending_cache = {};

// disk cache tier for /api/trending (mirror live_disk_*): persist successful
// responses across restarts/workers; TTL via TRENDING_DISK_TTL_SEC (default 600).
func trending_disk_ttl() {
  let v = env("TRENDING_DISK_TTL_SEC");
  if (v == null) { return 600; }
  let n = int(v, 600);
  if (n < 0) { return 0; }
  return n;
}

func trending_disk_keyfile(k) {
  let f = replace(k, "/", "__");
  f = replace(f, " ", "_");
  f = replace(f, "?", "_");
  f = replace(f, "&", "_");
  f = replace(f, "=", "_");
  f = replace(f, ":", "_");
  f = replace(f, "|", "__");
  if (f == "") { return ""; }
  return f + ".json";
}

func trending_disk_read(k) {
  let f = trending_disk_keyfile(k);
  if (f == "") { return null; }
  let raw = read_file("data/github/trending/" + f);
  if (raw == null or raw == "") { return null; }
  return sh.safe_json(raw);
}

func trending_disk_write(k, body) {
  let f = trending_disk_keyfile(k);
  if (f == "" or body == "") { return false; }
  mkdir("data/github/trending");
  let payload = str({ at: int(now(), 0), body: body });
  return write_file("data/github/trending/" + f, payload);
}

get "/api/trending", (req) => {
  let qp = get(req, "query_params", {});
  let since = str(get(qp, "since", "daily"));
  if (since != "daily" and since != "weekly" and since != "monthly") { since = "daily"; }
  let lang = str(get(qp, "lang", ""));
  if (lang != "" and not trending_valid_lang(lang)) {
    return { ok: false, status: 400, err: "invalid lang" };
  }
  // translation target (only Simplified Chinese is supported for now); part of
  // the cache key so an English request never gets a translated payload.
  let tr = str(get(qp, "tr", ""));
  if (tr != "zh") { tr = ""; }
  // optional owner scope: rank ONE owner's own newly-created repos instead of
  // the global feed (user:<login> created:>window). Invalid logins are ignored
  // (fall back to the global feed) rather than 400 — the owner box is optional.
  let owner_login = sh.sanitize_owner(str(get(qp, "owner", "")));

  // memory TTL cache keyed by window+language+translation+scope: repeated tab
  // views reuse one upstream fetch instead of re-scraping / burning Search API
  // quota. `refresh=1` skips both cache tiers and re-fetches fresh (the UI's
  // refresh button and make trending-push set it).
  let refresh = str(get(qp, "refresh", ""));
  let force = (refresh == "1" or refresh == "true" or refresh == "yes");
  let key = since + "|" + lang + "|" + tr + "|" + owner_login;
  let ttl = trending_ttl();
  if (ttl > 0 and not force) {
    let hit = get(_trending_cache, key, null);
    if (hit != null and (int(now(), 0) - int(get(hit, "at", 0), 0)) < ttl) {
      let cached = sh.safe_json(get(hit, "body", ""));
      if (cached != null) { put(cached, "cached", true); return cached; }
    }
  }
  let disk_ttl = trending_disk_ttl();
  if (disk_ttl > 0 and not force) {
    let d = trending_disk_read(key);
    if (d != null) {
      let at = int(get(d, "at", 0), 0);
      if ((int(now(), 0) - at) < disk_ttl) {
        let cbody = str(get(d, "body", ""));
        if (cbody != "") {
          if (ttl > 0) { put(_trending_cache, key, { at: at, body: cbody }); }
          let cobj = sh.safe_json(cbody);
          if (cobj != null) { put(cobj, "cached", true); return cobj; }
        }
      }
    }
  }

  let days = trending_days(since);
  let today = str(strftime("%Y-%m-%d", int(now(), 0)));
  let items: any = null;
  let source = "";

  // 1) scrape github.com/trending for the global feed — the exact list, order
  //    and star counts the page shows. The page only offers the daily/weekly/
  //    monthly windows and no owner scope; a language is scoped via the path
  //    only when it has a trending slug (C++ / C# etc. fall back to search).
  let slug = "";
  if (lang != "") { slug = trending_lang_slug(lang); }
  let page_ok = owner_login == "" and not (lang != "" and slug == "")
    and (since == "daily" or since == "weekly" or since == "monthly");
  if (page_ok) {
    let pr = sh.gh_get(trending_scrape_url(since, slug),
      { "Accept": "text/html", "User-Agent": "lume-talentlens (+https://github.com/trending)" });
    let pstat = int(get(pr, "status", 0), 0);
    if (str(get(pr, "err", "")) == "" and pstat >= 200 and pstat < 300) {
      let parsed = th.parse_trending(str(get(pr, "body", "")));
      if (len(parsed) > 0) { items = parsed; source = "github-trending"; }
    }
  }

  // 2) fall back to the GitHub Search API (repos *created* in the window,
  //    sorted by stars) so the tab never goes blank when the page is unparseable.
  if (items == null) {
    // query carries is:public (see trending_query) — never broaden it.
    let q = trending_query(since, lang, owner_login);
    let url = "https://api.github.com/search/repositories?q=" + trending_enc(q)
      + "&sort=stars&order=desc&per_page=25";

    let headers = { "Accept": "application/vnd.github+json", "User-Agent": "lume-talentlens" };
    // GH_ANALYZER_PAT is the Makefile alias of GH_TOKEN (env() masks names
    // containing TOKEN/API_KEY/SECRET/PASSWORD; the trusted route reads the alias).
    let tok = env("GH_ANALYZER_PAT");
    if (tok != null and tok != "") { put(headers, "Authorization", "Bearer " + str(tok)); }

    let r = sh.gh_get(url, headers);
    let up = int(get(r, "status", 0), 0);
    let herr = str(get(r, "err", ""));
    let body = str(get(r, "body", ""));
    if (herr != "" or up < 200 or up >= 300) {
      let emsg = herr;
      if (emsg == "") { emsg = "github http " + str(up); }
      return { ok: false, status: up, since: since, lang: lang, err: emsg };
    }

    let d = sh.safe_json(body);
    let items_raw = null;
    if (d != null) { items_raw = get(d, "items", null); }
    if (items_raw == null) {
      let emsg = "unexpected github response";
      if (d != null) { emsg = s(get(d, "message", emsg)); }
      return { ok: false, status: up, since: since, lang: lang, err: emsg };
    }

    // project each result down to the handful of fields the dashboard renders
    // (25 items -> a few KB; the framework caps a single response body).
    items = [];
    for (let it in items_raw) {
      // defence-in-depth: drop anything the API still marks private, so a
      // private repo name/description can never reach the client even if
      // is:public fails.
      if (get(it, "private", false) == true) { continue; }
      let owner = get(it, "owner", {});
      push(items, {
        full_name: s(get(it, "full_name", null)),
        name: s(get(it, "name", null)),
        owner: s(get(owner, "login", null)),
        owner_avatar: s(get(owner, "avatar_url", null)),
        url: s(get(it, "html_url", null)),
        desc: s(get(it, "description", null)),
        lang: s(get(it, "language", null)),
        stars: int(get(it, "stargazers_count", 0), 0),
        forks: int(get(it, "forks_count", 0), 0),
        issues: int(get(it, "open_issues_count", 0), 0),
        topics: get(it, "topics", []),
        homepage: s(get(it, "homepage", null)),
        created_at: s(get(it, "created_at", null)),
        pushed_at: s(get(it, "pushed_at", null)),
      });
    }
    source = "github-search";
  }

  // machine-translate the descriptions when requested (adds desc_zh in place).
  // cache_ok is false when a configured gateway had missing work but translated
  // none of it — we must not cache that, or a transient outage would serve an
  // English payload as `tr=zh` for the whole TTL even after it recovers.
  let cache_ok = true;
  if (tr == "zh") { cache_ok = trending_translate_items(items); }

  let scope = "owner";
  if (owner_login == "") { scope = "global"; }
  let out = {
    ok: true,
    scope: scope,
    owner: owner_login,
    since: since,
    lang: lang,
    days: days,
    generated_at: today,
    source: source,
    count: len(items),
    items: items,
  };
  // skip both cache tiers when a zh translation was attempted but produced
  // nothing (cache_ok) — a failure must not outlive the request.
  if (cache_ok) {
    if (ttl > 0) {
      put(_trending_cache, key, { at: int(now(), 0), body: str(out) });
    }
    let disk_ttl2 = trending_disk_ttl();
    if (disk_ttl2 > 0) {
      trending_disk_write(key, str(out));
    }
  }
  return out;
};
