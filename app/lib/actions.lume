// lib/actions.lume — write-action endpoints: the framework capability catalog
// (/discovery) and the follow/unfollow proxies that act on the user's GitHub
// account via the PAT.

// ------------------------------------------------ /discovery
// Boot-time capability catalog. The framework builtins discovery_endpoints /
// skills / tools / mcps do NOT exist in the full build we run on — and Lume
// has no way to test for an undefined variable (even `== undefined` aborts),
// so *referencing* them here would turn this endpoint into a 500. This route
// therefore serves the app's OWN registration summary, which is what
// tooling/debugging actually needs; if a future build gains the agent-catalog
// builtins, call them here (guarded) and merge the results into `out`.
get "/discovery", (req) => {
  return {
    app: {
      routes: ["/api/owners", "/api/overview", "/api/repos", "/api/top", "/api/langs",
               "/api/recency", "/api/year", "/api/people", "/api/search", "/api/radar",
               "/api/people_diff", "/api/refresh", "/api/live/github", "/api/github_auth",
               "/discovery", "/overview", "/repos", "/api"],
      tools: ["repo_insights", "repo_search", "repo_language", "repo_recency", "repo_year",
              "repo_stats", "github_story", "github_owners", "github_radar", "github_people"],
      note: "framework agent-catalog builtins (discovery_endpoints/skills/tools/mcps) are absent from this build; app catalog attached instead",
    },
  };
};

// ------------------------------------------------ /api/follow
// One-click follow from the "worth following" panel. The browser POSTs the
// target login, the server proxies PUT /user/following/<login> with the PAT
// (idempotent — GitHub answers 204 whether you just followed or already
// followed). Requires GH_TOKEN with the user:follow scope.
//
// CSRF guard: write actions accept ONLY application/json. The dashboard's
// fetch always sends that header (triggers a CORS preflight from any other
// origin — and this server sends no CORS headers, so cross-site JSON is
// blocked by the browser), while HTML forms (urlencoded/text-plain) and
// simple text/plain fetches are rejected here before the body is parsed.
// Headerless local calls (curl with -d) still work: empty body -> 400.
post "/api/follow", (req) => {
  let ct = str(get(req, "content_type", ""));
  let ct_ok = ct == "" or len(replace(ct, "application/json", "")) < len(ct);
  if (!ct_ok) {
    return { ok: false, status: 403, err: "write actions require Content-Type: application/json" };
  }
  let b = str(get(req, "body", ""));
  if (b == "") {
    return { ok: false, status: 400, err: "missing login" };
  }
  let d = json(b);
  if (d == null or str(get(d, "login", "")) == "") {
    return { ok: false, status: 400, err: "missing login" };
  }
  let tok = env("GH_ANALYZER_PAT");
  if (tok == null or tok == "") {
    return { ok: false, status: 401, err: "GH_TOKEN not set — needs user:follow scope" };
  }
  let headers = { "Accept": "application/vnd.github+json", "User-Agent": "lume-talentlens",
                  "Authorization": "Bearer " + str(tok) };
  let url = "https://api.github.com/user/following/" + str(get(d, "login", ""));
  // GitHub's edge is flaky (TLS handshake / HTTP2 hiccups) and a failed PUT
  // can drop the connection entirely, so retry a few times with a shorter
  // per-attempt window — first success wins, worst case ~24s then a clear err.
  let r = http_put(url, { headers: headers, timeout: 8, max_bytes: 1024 });
  for (let i = 1; i < 3; i = i + 1) {
    if (int(get(r, "status", 0), 0) == 204) { break; }
    r = http_put(url, { headers: headers, timeout: 8, max_bytes: 1024 });
  }
  let up = int(get(r, "status", 0), 0);
  if (up == 204) { return { ok: true, status: 204, err: "" }; }
  return { ok: false, status: up, err: str(get(r, "err", "")) };
};

// ------------------------------------------------ /api/unfollow
// Unfollow a water-account from the people toolbar. DELETE /user/following/
// <login> with the PAT (204 whether you just unfollowed or never followed).
// Same Content-Type CSRF guard as /api/follow (see above).
delete "/api/unfollow", (req) => {
  let ct = str(get(req, "content_type", ""));
  let ct_ok = ct == "" or len(replace(ct, "application/json", "")) < len(ct);
  if (!ct_ok) {
    return { ok: false, status: 403, err: "write actions require Content-Type: application/json" };
  }
  let b = str(get(req, "body", ""));
  if (b == "") {
    return { ok: false, status: 400, err: "missing login" };
  }
  let d = json(b);
  if (d == null or str(get(d, "login", "")) == "") {
    return { ok: false, status: 400, err: "missing login" };
  }
  let tok = env("GH_ANALYZER_PAT");
  if (tok == null or tok == "") {
    return { ok: false, status: 401, err: "GH_TOKEN not set — needs user:follow scope" };
  }
  let headers = { "Accept": "application/vnd.github+json", "User-Agent": "lume-talentlens",
                  "Authorization": "Bearer " + str(tok) };
  let url = "https://api.github.com/user/following/" + str(get(d, "login", ""));
  // same flaky-edge retry as /api/follow (short per-attempt window, 3 tries)
  let r = http_delete(url, { headers: headers, timeout: 8, max_bytes: 1024 });
  for (let i = 1; i < 3; i = i + 1) {
    if (int(get(r, "status", 0), 0) == 204) { break; }
    r = http_delete(url, { headers: headers, timeout: 8, max_bytes: 1024 });
  }
  let up = int(get(r, "status", 0), 0);
  if (up == 204) { return { ok: true, status: 204, err: "" }; }
  return { ok: false, status: up, err: str(get(r, "err", "")) };
};
