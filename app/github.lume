// ============================================================================
// github.lume — recruit-facing talent signals from a GitHub owner, on Lume.
//
// The owner is chosen in the UI (or via ?owner=) and every route/tool
// resolves that owner's local snapshot under data/github/<owner>/. Snapshots
// are produced offline by scripts/fetch-github.sh (OWNER=foo make fetch);
// the server itself only calls the live GitHub API through the live proxy
// and follow/unfollow endpoints below.
//
// This entry module is deliberately thin: routes and tools live in lib/
// modules, each imported here so their top-level registrations take effect.
//
//   lib/shared.lume   owner/snapshot/string helpers + gh_get (pure exports)
//   lib/api.lume      JSON APIs: owners/overview/repos/top/langs/recency/year/
//                     people/search/radar/refresh/people_diff
//   lib/live.lume     live GitHub proxy (/api/live/github + /api/github_auth)
//   lib/ssr.lume      SSR pages (/overview, /repos, /api reference)
//   lib/tools.lume    LLM agent tools (repo_* / github_*)
//   lib/actions.lume  /discovery + POST /api/follow + DELETE /api/unfollow
//
// Run:  make dev   (full Lume build, see Makefile LUME)
//
// Routes:
//   /             — React SPA dashboard (static, views dir)
//   /overview     — SSR overview (?owner=)
//   /repos        — SSR full repo list (?owner=)
//   /api          — SSR API reference
//   /chat         — React agent chat shell (static)
//   /api/owners   — JSON: list of locally-cached owners
//   /api/overview — JSON: aggregates for ?owner= (404 + hint when no snapshot)
//   /api/repos    — JSON: paged repos for ?owner= (&offset=&limit=)
//   /api/top /api/langs /api/recency /api/year /api/search /api/radar
//   /api/people /api/people_diff /api/refresh
//   /api/live/github  — server-side GitHub fetch proxy (?path=)
//   /api/github_auth  — whether live calls are authenticated (bool only)
//   /discovery    — boot-time tool/skill/MCP catalog
//   POST /api/follow / DELETE /api/unfollow — act on the user's account
//
// Agent tools (all accept an optional { owner } param, default = last owner
// fetched; repo_search also takes { q }):
//   repo_insights / repo_search / repo_language / repo_recency /
//   repo_year / repo_stats / github_story / github_owners /
//   github_radar / github_people
//
// When an owner has no local snapshot, JSON routes answer
//   { "status": 404, "error": "no_snapshot", "owner": …, "hint": "run: make fetch OWNER=…" }
// ============================================================================

// ============================================================================
// Outbound-HTTP builtins
// ----------------------
// /api/live/github, /api/refresh and the follow/unfollow endpoints rely on
// Lume's outbound-HTTP builtins (http_get / http_put / http_delete). This app
// is meant to run on a full Lume build; the public release binary (agent-httpd
// 1.0) ships WITHOUT those builtins and will fail at runtime — run this app
// with a full build (e.g. the one built in work/research/lume via `make`).
// ============================================================================

import "lib/shared.lume" as sh;
import "lib/api.lume" as api;
import "lib/live.lume" as live;
import "lib/ssr.lume" as ssr;
import "lib/tools.lume" as tools;
import "lib/actions.lume" as actions;

// port is env-overridable (LUME_GITHUB_PORT) so a dev can shift it if the
// default 8091 is taken.
func server_port() {
  let v = env("LUME_GITHUB_PORT");
  if (v == null) { return 8091; }
  let p = int(v, 8091);
  if (p <= 0) { return 8091; }
  return p;
}

server {
  port = server_port();
  workers = 4;
  bind = "127.0.0.1";
  docroot = "./www";
  views = "github";
}

run();
