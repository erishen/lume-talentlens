// ------------------------------------------------ agent tools
// Optional { owner } param on every repo tool: when absent (""), the default
// owner (last fetched) is used. Tools run on a forked worker — snapshot reads
// are per-call, so no stale shared state.

func tool_owner(arg) {
  let o = owner_arg(arg);
  if (o == "") { return default_owner(); }
  return o;
}
// shared no-snapshot error shape for agent tools
func tool_no_snapshot(arg) {
  return { error: "no_snapshot", owner: tool_owner(arg),
           hint: "run: OWNER=" + tool_owner(arg) + " make fetch" };
}
// repo list for a tool arg, or null when that owner has no snapshot. Callers
// MUST check `== null` and return tool_no_snapshot(arg) in that case.
func tool_repos(arg) {
  let snap = load_snap(tool_owner(arg));
  if (snap == null) { return null; }
  return active_repos(snap);
}

tool "repo_insights",
     "Compact recruiting insight for a GitHub owner: repo/activity totals, top language (incl. top-2 share), most-starred repo, and talent signals (active-within-90d ratio, description/license/topic coverage, avg days since last push, followers). Optional owner.",
     { owner: string },
     (arg) => {
       let repos = tool_repos(arg);
       if (repos == null) { return tool_no_snapshot(arg); }
       let snap = load_snap(tool_owner(arg));
       return gh.insight(repos, snap);
     };

tool "repo_search",
     "Case-insensitive substring search across an owner's repo name, description, topics, and language. Params: optional owner, q.",
     { owner: string, q: string },
     (arg) => {
       let repos = tool_repos(arg);
       if (repos == null) { return tool_no_snapshot(arg); }
       let q = str(get(arg, "q", ""), "");
       let needle = lower(q);
       let out = [];
       for (let r in repos) {
         let v = gh.repo_view(r);
         if (contains(haystack(v), needle)) {
           push(out, v);
         }
       }
       let capped = gh.first_n(out, 10);
       return { owner: tool_owner(arg), q: q, total: len(out), shown: capped };
     };

tool "repo_language",
     "Language histogram {lang: count} for an owner (optional owner).",
     { owner: string },
     (arg) => {
       let repos = tool_repos(arg);
       if (repos == null) { return tool_no_snapshot(arg); }
       return gh.lang_histogram(repos);
     };

tool "repo_recency",
     "Recency histogram for an owner: active(≤90d) / recent(≤365d) / dormant(≤2y) / stale(>2y) / unknown.",
     { owner: string },
     (arg) => {
       let repos = tool_repos(arg);
       if (repos == null) { return tool_no_snapshot(arg); }
       return gh.recency_histogram(repos);
     };

tool "repo_year",
     "Creation-year histogram {year: count} for an owner.",
     { owner: string },
     (arg) => {
       let repos = tool_repos(arg);
       if (repos == null) { return tool_no_snapshot(arg); }
       return gh.year_histogram(repos);
     };

tool "repo_stats",
     "Global counters for an owner: total stars, forks, open issues, archived, fork counts.",
     { owner: string },
     (arg) => {
       let repos = tool_repos(arg);
       if (repos == null) { return tool_no_snapshot(arg); }
       let snap = load_snap(tool_owner(arg));
       let a = gh.analyze(repos, snap);
       return a.totals;
     };

tool "github_story",
     "Career-story material for a GitHub owner, shaped for generating an interview self-intro / project stories: profile basics, repo totals, language mix, activity cadence, talent signals, and the top starred repos (name/language/stars/recency/description/url). Optional owner. When the user asks for a self-intro or project story, structure the answer as: (1) a 60-90s spoken self-intro (path: past stack -> current focus, backed by real repo counts), (2) 2-3 project stories each as background / my role / technical challenge / outcome, grounded in real repo names & stats, (3) a short skill-tag line. Do NOT invent repos, stars, or roles the tool data does not show.",
     { owner: string },
     (arg) => {
       let repos = tool_repos(arg);
       if (repos == null) { return tool_no_snapshot(arg); }
       let snap = load_snap(tool_owner(arg));
       return gh.story_pack(repos, snap);
     };

tool "github_owners",
     "List the GitHub owners whose snapshots are cached locally under data/github/, plus the current default owner.",
     {},
     (arg) => {
       return { owners: cached_owners(), current: default_owner() };
     };

tool "github_radar",
     "Talent radar — the default account's mutual high scorers (score >= 120) classified by money pattern: each person's mode (startup / crypto / company / content / tools / hunting / other), one-line evidence, score, and hireable flag. When the user asks who among their network is a real talent, how those people make money, or which startups/crypto/content people to learn from, use this and answer grouped by mode with the evidence notes. If the data is missing, suggest running make radar.",
     {},
     (arg) => {
       let raw = read_file("data/github/" + default_owner() + "/radar.json");
       if (raw == null or raw == "") {
         return { status: 404, error: "no_radar", hint: "run: make radar" };
       }
       return json(raw);
     };

tool "github_people",
     "Network snapshot for the default account — followers/following (first page each), totals, water-account pre-screen flags (suspect: high/medium), and the mutual-following overlap. Useful to answer who follows the user, who the user follows, how many are mutual, and which are likely water accounts. Computed from local data only (suspects.json merge); no live GitHub calls.",
     {},
     (arg) => {
       let o = default_owner();
       let raw = read_file("data/github/" + o + "/people.json");
       if (raw == null or raw == "") {
         return { status: 404, error: "no_people", owner: o, hint: "refresh the people view or run people-scan" };
       }
       let p = json(raw);
       if (p == null) { return { status: 500, error: "bad_people" }; }
       // merge suspect flags so the agent sees the same chips the UI does
       let suspects = read_file("data/github/" + o + "/suspects.json");
       if (suspects != null and suspects != "") {
         let by = {};
         let sd = json(suspects);
         let arr = get(sd, "suspects", sd);
         // for-in walks both lists and maps; if suspects.json wraps the
         // array under "suspects" the default above already unwraps it
         for (let s in arr) {
           if (s == null) { continue; }
           put(by, str(get(s, "login", "")), str(get(s, "level", "medium")));
         }
         // Lume has no block-scoped func — inline the flag merge for both
         // lists, rebuilding each list so the suspect flags are baked in
         let fl = [];
         for (let row in get(p, "followers", [])) {
           let login = str(get(row, "login", ""));
           let lv = str(get(by, login, ""));
           if (lv != "") { put(row, "suspect", lv); }
           push(fl, row);
         }
         put(p, "followers", fl);
         let fg = [];
         for (let row in get(p, "following", [])) {
           let login = str(get(row, "login", ""));
           let lv = str(get(by, login, ""));
           if (lv != "") { put(row, "suspect", lv); }
           push(fg, row);
         }
         put(p, "following", fg);
       }
       return p;
     };

// ------------------------------------------------ /discovery
get "/discovery", (req) => {
  return {
    endpoints: discovery_endpoints(),
    skills: skills(),
    tools: tools(),
    mcps: mcps(),
  };
};

// ------------------------------------------------ /api/follow
// One-click follow from the "worth following" panel. The browser POSTs the
// target login, the server proxies PUT /user/following/<login> with the PAT
// (idempotent — GitHub answers 204 whether you just followed or already
// followed). Requires GH_TOKEN with the user:follow scope.
post "/api/follow", (req) => {
  let b = str(get(req, "body", ""));
  let d = json(b);
  if (d == null or str(get(d, "login", "")) == "") {
    return { ok: false, status: 400, err: "missing login" };
  }
  let tok = env("GH_ANALYZER_PAT");
  if (tok == null or tok == "") {
    return { ok: false, status: 401, err: "GH_TOKEN not set — needs user:follow scope" };
  }
  let headers = { "Accept": "application/vnd.github+json", "User-Agent": "lume-talentlens",
                  "Authorization": "Bearer " + str(tok) };
  let url = "https://api.github.com/user/following/" + str(get(d, "login", ""));
  let r = http_put(url, { headers: headers, timeout: 30, max_bytes: 1024 });
  let up = int(get(r, "status", 0), 0);
  if (up == 204) { return { ok: true, status: 204, err: "" }; }
  return { ok: false, status: up, err: str(get(r, "err", "")) };
};

// ------------------------------------------------ /api/unfollow
// Unfollow a water-account from the people toolbar. DELETE /user/following/
// <login> with the PAT (204 whether you just unfollowed or never followed).
delete "/api/unfollow", (req) => {
  let b = str(get(req, "body", ""));
  let d = json(b);
  if (d == null or str(get(d, "login", "")) == "") {
    return { ok: false, status: 400, err: "missing login" };
  }
  let tok = env("GH_ANALYZER_PAT");
  if (tok == null or tok == "") {
    return { ok: false, status: 401, err: "GH_TOKEN not set — needs user:follow scope" };
  }
  let headers = { "Accept": "application/vnd.github+json", "User-Agent": "lume-talentlens",
                  "Authorization": "Bearer " + str(tok) };
  let url = "https://api.github.com/user/following/" + str(get(d, "login", ""));
  let r = http_delete(url, { headers: headers, timeout: 30, max_bytes: 1024 });
  let up = int(get(r, "status", 0), 0);
  if (up == 204) { return { ok: true, status: 204, err: "" }; }
  return { ok: false, status: up, err: str(get(r, "err", "")) };
};

// ------------------------------------------------ run
run();
