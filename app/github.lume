// ============================================================================
// github.lume — recruit-facing talent signals from a GitHub owner, on Lume.
//
// The owner is chosen in the UI (or via ?owner=) and every route/tool
// resolves that owner's local snapshot under data/github/<owner>/. Snapshots
// are produced offline by scripts/fetch-github.sh (OWNER=foo make fetch);
// the server itself never calls the live GitHub API.
//
// Run:  make dev   /  make run
//
// Routes:
//   /             — React SPA dashboard (static, views dir)
//   /overview     — SSR overview (?owner=)
//   /repos        — SSR full repo list (?owner=)
//   /api          — SSR API reference
//   /chat         — React agent chat shell (static)
//   /api/owners   — JSON: list of locally-cached owners
//   /api/overview — JSON: aggregates for ?owner= (404 + hint when no snapshot)
//   /api/repos    — JSON: paged repos for ?owner= (&offset=&limit=)
//   /api/top /api/langs /api/recency /api/year /api/search
//   /discovery    — GET: boot-time tool/skill/MCP catalog
//
// Agent tools (all accept an optional { owner } param, default = last owner
// fetched; repo_search also takes { q }):
//   repo_insights / repo_search / repo_language / repo_recency /
//   repo_year / repo_stats / github_story / github_owners
//
// When an owner has no local snapshot, JSON routes answer
//   { "status": 404, "error": "no_snapshot", "owner": …, "hint": "run: make fetch OWNER=…" }
// ============================================================================

// ============================================================================
// Outbound-HTTP capability gate
// -----------------------------
// The live proxy (/api/live/github), the people refresh (/api/refresh) and the
// follow/unfollow endpoints rely on Lume's outbound-HTTP builtins
// (http_get / http_put / http_delete). Those exist only in full builds; the
// public release binary (agent-httpd 1.0) ships WITHOUT them, so the whole app
// would fail to compile on a release binary. These stubs keep a release build
// bootable: any outbound call answers a clear "unavailable" result and the
// routes above surface it as a 501-ish error instead of a crash.
//
// To restore live/follow/unfollow, run the app on a full build and delete this
// block (the builtins then resolve normally).

let HTTP_UNAVAILABLE_MSG = "outbound http unavailable in this lume build (release build lacks http_get/http_put/http_delete) — use a full build for live fetch / refresh / follow / unfollow";

func http_get(url, opts) {
  return { status: -1, err: HTTP_UNAVAILABLE_MSG, body: "" };
}
func http_put(url, opts) {
  return { status: -1, err: HTTP_UNAVAILABLE_MSG, body: "" };
}
func http_delete(url, opts) {
  return { status: -1, err: HTTP_UNAVAILABLE_MSG, body: "" };
}

// port is env-overridable (LUME_GITHUB_PORT) so a dev can shift it if the
// default 8091 is taken.
func server_port() {
  let v = env("LUME_GITHUB_PORT");
  if (v == null) { return 8091; }
  let p = int(v, 8091);
  if (p <= 0) { return 8091; }
  return p;
}

server {
  port = server_port();
  // A few more prefork workers than the default 2: /api/people merges
  // suspects + scores over ~700 rows and can take a few seconds on the
  // release interpreter — one slow request used to block the whole pool.
  workers = 4;
  bind = "127.0.0.1";
  docroot = "./www";
  views = "github";
}

import "lib/github.lume" as gh;
import "lib/ui.lume" as ui;

// ------------------------------------------------ owner resolution
// Lume module exports do not propagate mutations into the importer, so every
// route/tool resolves its owner + snapshot locally and passes them into the
// pure gh.* helpers.

// read data/github/last_owner (written by scripts/fetch-github.sh), or the
// OWNER env (CWD .env is loaded at server start) — in that order; empty when
// neither is set, so a public clone without local config shows a clear
// "no owner" state instead of silently defaulting to someone's login.
func default_owner() {
  let me = env("OWNER");
  if (me != null and str(me) != "") { return str(me); }
  let raw = read_file("data/github/last_owner");
  if (raw == null) { return ""; }
  let s = replace(raw, "\n", "");
  s = replace(s, " ", "");
  if (s == "") { return ""; }
  return s;
}

// A safe owner is a single path component (GitHub logins): <= 39 chars, and
// must not contain any of . / % space # ? — these keep snapshot lookups from
// ever escaping data/github/<owner>/.
func sanitize_owner(s) {
  if (s == null) { return ""; }
  s = str(s);
  if (s == "") { return ""; }
  if (len(s) > 39) { return ""; }
  if (contains(s, ".") or contains(s, "/") or contains(s, "%")
      or contains(s, " ") or contains(s, "#") or contains(s, "?")
      or contains(s, "\n")) {
    return "";
  }
  return s;
}

// owner from ?owner= (req-based); empty string when the param is absent.
// (Lume `.` member access requires the field to exist; use get() with a
// default so a missing owner param yields "".)
func owner_param(req) {
  let qp = get(req, "query_params", {});
  return sanitize_owner(get(qp, "owner", ""));
}

// language from ?lang= (req-based); "zh" default, "en" accepted, anything
// else (including absent) falls back to "zh" — matches the React shell's
// localStorage default so both entry points agree out of the box.
func lang_param(req) {
  let qp = get(req, "query_params", {});
  let l = str(get(qp, "lang", "zh"));
  if (l == "en") { return "en"; }
  return "zh";
}

// owner from a tool argument map; empty string when the arg is absent.
func owner_arg(arg) {
  return sanitize_owner(get(arg, "owner", ""));
}

// snapshot for one owner, or null when that owner has not been fetched yet.
func load_snap(owner) {
  let raw = read_file("data/github/" + owner + "/snapshot.json");
  if (raw == null) { return null; }
  let s = json(raw);
  if (s == null) { return null; }
  return s;
}

// repos that public views should surface: archived repositories are excluded
// everywhere (lists, search, histograms, KPIs) — the raw snapshot still keeps
// them for history, this is purely a display/analysis filter.
func active_repos(snap) {
  let all = get(snap, "repos", []);
  return filter((r) => not bool(get(r, "archived", false)), all);
}

// shared no-snapshot JSON error shape (JSON routes)
func no_snapshot(owner) {
  return {
    status: 404,
    error: "no_snapshot",
    owner: owner,
    hint: "run: OWNER=" + owner + " make fetch   (or make fetch OWNER=" + owner + ")",
  };
}

func bundle(repos, snap) {
  // /overview renders aggregates only (KPIs, histograms, top-10 lists) and
  // never touches the full `all` array — analyze_lite skips building it.
  return gh.analyze_lite(repos, snap);
}

// ------------------------------------------------ local string helpers
// Lume has no lower/contains builtins; implement them over `replace`.
func lower(x) {
  x = replace(x, "A", "a"); x = replace(x, "B", "b"); x = replace(x, "C", "c");
  x = replace(x, "D", "d"); x = replace(x, "E", "e"); x = replace(x, "F", "f");
  x = replace(x, "G", "g"); x = replace(x, "H", "h"); x = replace(x, "I", "i");
  x = replace(x, "J", "j"); x = replace(x, "K", "k"); x = replace(x, "L", "l");
  x = replace(x, "M", "m"); x = replace(x, "N", "n"); x = replace(x, "O", "o");
  x = replace(x, "P", "p"); x = replace(x, "Q", "q"); x = replace(x, "R", "r");
  x = replace(x, "S", "s"); x = replace(x, "T", "t"); x = replace(x, "U", "u");
  x = replace(x, "V", "v"); x = replace(x, "W", "w"); x = replace(x, "X", "x");
  x = replace(x, "Y", "y"); x = replace(x, "Z", "z");
  return x;
}
func contains(s, needle) {
  if (needle == "") { return true; }
  return len(replace(s, needle, "")) < len(s);
}
func join_topics(topics) {
  return reduce((acc, t) => acc + str(t) + " ", topics, "");
}
func haystack(v) {
  return lower(str(get(v, "name", "")) + " "
    + str(get(v, "desc", "")) + " "
    + str(get(v, "lang", "")) + " "
    + join_topics(get(v, "topics", [])));
}

// ------------------------------------------------ JSON APIs
// NOTE: the HTTP framework caps a single response body, so the "overview"
// endpoint ships aggregates only (no full list). The full list is paged via
// /api/repos?owner=&offset=&limit=.

// locally-cached owners = sub-directories of data/github (files() marks dirs
// with a trailing "/"; a bare "last_owner" file has no slash).
func cached_owners() {
  let entries = files("data/github");
  let out = [];
  for (let e in entries) {
    let s = str(e);
    let stripped = replace(s, "/", "");
    if (s != stripped and stripped != "") {
      push(out, stripped);
    }
  }
  return out;
}

get "/api/owners", (req) => {
  return {
    owners: cached_owners(),
    current: default_owner(),
  };
};

get "/api/overview", (req) => {
  let owner = owner_param(req);
  if (owner == "") { owner = default_owner(); }
  let snap = load_snap(owner);
  if (snap == null) { return no_snapshot(owner); }
  let repos = active_repos(snap);
  return gh.analyze_lite(repos, snap);
};

get "/api/repos", (req) => {
  let qp = get(req, "query_params", {});
  let owner = sanitize_owner(get(qp, "owner", ""));
  if (owner == "") { owner = default_owner(); }
  let snap = load_snap(owner);
  if (snap == null) { return no_snapshot(owner); }
  let repos = active_repos(snap);
  let offset = int(get(qp, "offset", 0), 0);
  let limit = int(get(qp, "limit", 25), 25);
  if (offset < 0) { offset = 0; }
  if (limit <= 0) { limit = 25; }
  // clamp to 50: at 50/page the response is ~30KB, comfortably under the
  // framework's response-size cap (100/page would silently truncate larger
  // owners).
  if (limit > 50) { limit = 50; }
  let page_src = gh.slice(repos, offset, limit);
  let page = map(gh.repo_view, page_src);
  return {
    owner: owner,
    offset: offset,
    limit: limit,
    total: len(repos),
    count: len(page),
    repos: page,
  };
};

get "/api/top", (req) => {
  let owner = owner_param(req);
  if (owner == "") { owner = default_owner(); }
  let snap = load_snap(owner);
  if (snap == null) { return no_snapshot(owner); }
  let a = gh.analyze_lite(active_repos(snap), snap);
  return { owner: owner, top_by_stars: a.top_by_stars, top_by_activity: a.top_by_activity };
};

get "/api/langs", (req) => {
  let owner = owner_param(req);
  if (owner == "") { owner = default_owner(); }
  let snap = load_snap(owner);
  if (snap == null) { return no_snapshot(owner); }
  return gh.lang_histogram(active_repos(snap));
};

get "/api/recency", (req) => {
  let owner = owner_param(req);
  if (owner == "") { owner = default_owner(); }
  let snap = load_snap(owner);
  if (snap == null) { return no_snapshot(owner); }
  return gh.recency_histogram(active_repos(snap));
};

get "/api/year", (req) => {
  let owner = owner_param(req);
  if (owner == "") { owner = default_owner(); }
  let snap = load_snap(owner);
  if (snap == null) { return no_snapshot(owner); }
  return gh.year_histogram(active_repos(snap));
};

// people.json for one owner, or null when absent (pre-people snapshots).
func load_people(owner) {
  let raw = read_file("data/github/" + owner + "/people.json");
  if (raw == null) { return null; }
  let s = json(raw);
  if (s == null) { return null; }
  return s;
}

// merge a suspects.json pre-screen entry into a person row (no-op when absent)
// NOTE: keep rows slim — the release server's response path collapses for
// bodies around/above ~64KB (a full people payload took ~5s), so only fields
// the UI actually uses are carried. The API-confirmation evidence is flattened
// to a single note string (api_note) the UI shows in the hover tooltip.
func tag_suspect(p, lookup) {
  let s = get(lookup, str(get(p, "login", "")), null);
  if (s == null) { return p; }
  return {
    login: str(get(p, "login", "")),
    avatar: str(get(p, "avatar", "")),
    suspect: str(get(s, "level", "")),
    recruiter: bool(get(s, "maybe_recruiter", false)),
    api_note: str(get(get(s, "api", {}), "note", "")),
  };
}

// merge a scores.json talent-radar entry into a person row (no-op when
// absent); keeps any suspect/recruiter tags already attached by tag_suspect.
func tag_score(p, lookup) {
  let s = get(lookup, str(get(p, "login", "")), null);
  if (s == null) { return p; }
  return {
    login: str(get(p, "login", "")),
    avatar: str(get(p, "avatar", "")),
    suspect: str(get(p, "suspect", "")),
    recruiter: bool(get(p, "recruiter", false)),
    api_note: str(get(p, "api_note", "")),
    score: int(get(s, "score", 0), 0),
  };
}

get "/api/people", (req) => {
  let owner = owner_param(req);
  if (owner == "") { owner = default_owner(); }
  let snap = load_snap(owner);
  if (snap == null) { return no_snapshot(owner); }
  let people = load_people(owner);
  let people_missing = (people == null);
  if (people == null) { people = {}; }
  let followers = get(people, "followers", []);
  let following = get(people, "following", []);
  // water-account pre-screen (data/github/<owner>/suspects.json, if present):
  // tag each entry with suspect level + recruiter vocabulary flag.
  // Owner-scoped: only merged for the configured OWNER (env/.env) — the
  // pre-screen is only maintained for the user's own account.
  let me = env("OWNER");
  let suspects_raw = null;
  if (me != null and str(me) != "" and owner == str(me)) {
    suspects_raw = read_file("data/github/" + owner + "/suspects.json");
  }
  if (suspects_raw != null) {
    let lookup = {};
    for (let s in get(json(suspects_raw), "suspects", [])) {
      put(lookup, str(get(s, "login", "")), s);
    }
    followers = map((p) => tag_suspect(p, lookup), followers);
    following = map((p) => tag_suspect(p, lookup), following);
  }
  // talent-radar scores (data/github/<owner>/scores.json, if present):
  // merged per-login so the UI can sort by influence and badge high-scorers.
  let scores_raw = read_file("data/github/" + owner + "/scores.json");
  if (scores_raw != null) {
    let smap = json(scores_raw);
    if (smap != null) {
      followers = map((p) => tag_score(p, smap), followers);
      following = map((p) => tag_score(p, smap), following);
    }
  }
  let totals = get(people, "totals", {});
  // fall back to the profile counts when people.json predates the capture
  let prof = get(snap, "profile", {});
  if (get(totals, "followers", null) == null) {
    put(totals, "followers", int(get(prof, "followers", 0), 0));
  }
  if (get(totals, "following", null) == null) {
    put(totals, "following", int(get(prof, "following", 0), 0));
  }
  let note = str(get(people, "note", ""));
  if (people_missing) {
    note = "run OWNER=" + owner + " make fetch to capture the full people lists";
  }
  let out = {
    owner: owner,
    followers: followers,
    following: following,
    totals: totals,
    note: note,
  };
  return out;
};

get "/api/search", (req) => {
  let qp = get(req, "query_params", {});
  let owner = sanitize_owner(get(qp, "owner", ""));
  if (owner == "") { owner = default_owner(); }
  let snap = load_snap(owner);
  if (snap == null) { return no_snapshot(owner); }
  let repos = active_repos(snap);
  let q = get(qp, "q", "");
  let out = [];
  if (q == "") {
    out = map(gh.repo_view, repos);
  } else {
    let needle = lower(q);
    for (let r in repos) {
      let v = gh.repo_view(r);
      if (contains(haystack(v), needle)) {
        push(out, v);
      }
    }
  }
  // contract with the client (types.ts SearchResult) + agent tool repo_search:
  // { owner, q, total, shown } — shown capped so the body stays small.
  let shown = gh.first_n(out, 10);
  return { owner: owner, q: q, total: len(out), shown: shown };
};

// ------------------------------------------------ live GitHub proxy
// The browser can reach the Lume server (same origin) but often has no route
// to api.github.com (no CORS / no network egress). This route fetches a
// user-scoped GitHub path server-side via the built-in http_get() (outbound
// TLS via libssl) and returns a uniform envelope:
//   { ok: bool, status: <upstream HTTP or 0>, data: <JSON text>, err: <..> }
// The caller does JSON.parse(data) on ok. Unauthenticated GitHub allows
// ~60 req/h per shared server IP; set GH_TOKEN to raise it to 5000/h.
func live_safe_path(p) {
  if (p == "" or len(p) > 512) { return false; }
  // must be a user-scoped sub-path; the fixed "https://api.github.com" prefix
  // plus these guards mean p can never smuggle another host or scheme.
  if (not contains(p, "/users/")) { return false; }
  if (contains(p, ":") or contains(p, "//") or contains(p, " ") or contains(p, "..")) { return false; }
  return true;
}

// null-safe stringify for fields that may be null in the raw API payload.
func s(v) {
  if (v == null) { return ""; }
  return str(v);
}

// Slim a GitHub API body to only the fields the app consumes. Raw 100-repo
// pages are ~150-250KB of JSON — far past the framework's response-size cap —
// so the proxy must project before returning, or live fetch breaks for any
// owner with more than a handful of repos. `str()` re-serializes the
// projected map/array back to JSON text for the same `data` envelope.
func slim_body(p, body) {
  if (body == "" or body == "null") { return body; }
  let d = json(body);
  if (d == null) { return body; }
  if (contains(p, "/repos")) {
    let out = [];
    for (let r in d) {
      push(out, {
        name: s(get(r, "name", null)),
        full_name: s(get(r, "full_name", null)),
        language: s(get(r, "language", null)),
        stargazers_count: int(get(r, "stargazers_count", 0)),
        forks_count: int(get(r, "forks_count", 0)),
        open_issues_count: int(get(r, "open_issues_count", 0)),
        fork: bool(get(r, "fork", false)),
        archived: bool(get(r, "archived", false)),
        description: s(get(r, "description", null)),
        html_url: s(get(r, "html_url", null)),
        topics: get(r, "topics", []),
        created_at: s(get(r, "created_at", null)),
        updated_at: s(get(r, "updated_at", null)),
        pushed_at: s(get(r, "pushed_at", null)),
        size: int(get(r, "size", 0)),
        license: get(r, "license", null),
      });
    }
    return str(out);
  }
  if (contains(p, "/followers") or contains(p, "/following")) {
    let out = [];
    for (let u in d) {
      push(out, {
        login: s(get(u, "login", null)),
        name: s(get(u, "name", null)),
        avatar_url: s(get(u, "avatar_url", null)),
        url: s(get(u, "html_url", null)),
        type: s(get(u, "type", null)),
      });
    }
    return str(out);
  }
  // profile (or any other user-scoped path): keep only the fields the app
  // reads; null -> "" so the client's truthiness fallbacks don't show "null".
  return str({
    login: s(get(d, "login", null)),
    name: s(get(d, "name", null)),
    avatar_url: s(get(d, "avatar_url", null)),
    bio: s(get(d, "bio", null)),
    company: s(get(d, "company", null)),
    location: s(get(d, "location", null)),
    blog: s(get(d, "blog", null)),
    twitter_username: s(get(d, "twitter_username", null)),
    hireable: bool(get(d, "hireable", false)),
    followers: int(get(d, "followers", 0)),
    following: int(get(d, "following", 0)),
    public_repos: int(get(d, "public_repos", 0)),
    public_gists: int(get(d, "public_gists", 0)),
    created_at: s(get(d, "created_at", null)),
    html_url: s(get(d, "html_url", null)),
  });
}

// auth probe for the frontend: whether GitHub calls are authenticated
// (5000 req/h) or anonymous (~60 req/h). Never leaks the token itself — the
// UI uses this to pick throttle params and copy only. GH_ANALYZER_PAT is the
// Makefile-mapped alias of GH_TOKEN: env() masks any name containing
// TOKEN/API_KEY/SECRET/PASSWORD, so the trusted app reads the alias instead.
get "/api/github_auth", (req) => {
  let tok = env("GH_ANALYZER_PAT");
  return { authed: (tok != null and tok != "") };
};

// gh_get — GitHub GET with retry. The mainland network intermittently resets
// TLS handshakes to api.github.com (SSL_ERROR_SYSCALL / http=000 / "TLS
// handshake failed"); a reset handshake is usually transient, so retry a few
// times before giving up. Rate-limit responses (403/429) return immediately —
// retrying those is pointless and burns quota. No sleep primitive in Lume, so
// attempts are consecutive.
func gh_get(url, headers) {
  let i = 0;
  let last = { status: 0, body: "", err: "no attempt" };
  while (i < 3) {
    let r = http_get(url, { headers: headers, timeout: 30, max_bytes: 4194304 });
    let up = int(get(r, "status", 0), 0);
    let herr = str(get(r, "err", ""));
    if (herr == "" and up >= 200 and up < 300) { return r; }
    if (up == 403 or up == 429) { return r; }
    last = r;
    i = i + 1;
  }
  return last;
}

get "/api/live/github", (req) => {
  let qp = get(req, "query_params", {});
  let p = str(get(qp, "path", ""));
  if (not live_safe_path(p)) {
    return { ok: false, status: 400, data: "", err: "blocked GitHub path" };
  }
  let headers = { "Accept": "application/vnd.github+json", "User-Agent": "lume-talentlens" };
  // GH_ANALYZER_PAT is the Makefile alias of GH_TOKEN (env() masks names
  // containing TOKEN/API_KEY/SECRET/PASSWORD to keep untrusted scripts from
  // exfiltrating keys; the trusted live proxy reads the alias instead).
  let tok = env("GH_ANALYZER_PAT");
  if (tok != null and tok != "") { put(headers, "Authorization", "Bearer " + str(tok)); }
  let url = "https://api.github.com" + p;
  let r = gh_get(url, headers);
  let up = int(get(r, "status", 0), 0);
  let body = str(get(r, "body", ""));
  let herr = str(get(r, "err", ""));
  let ok = (up >= 200 and up < 300) and (herr == "");
  // project big payloads down before returning (see slim_body)
  if (ok and body != "") { body = slim_body(p, body); }
  return { ok: ok, status: up, data: body, err: herr };
};

// ------------------------------------------------ people refresh endpoint
// The dashboard's "refresh" button. Lume has no process spawn, so the
// followers/following fetch is inlined here via http_get() (the same path the
// live proxy uses) and people.json is rewritten atomically — no shell, no
// python. Rate-limited to one run per owner per REFRESH_GAP_SEC (anonymous
// GitHub is 60 req/h shared; this costs ~4-5 requests). The full water-account
// pre-screen (suspects.json) remains a `make fetch` + people-suspects.py job.

let REFRESH_GAP_SEC = 60;
let _refresh_at = {};

// fetch one paginated follower/following list, slimmed to app fields
func refresh_fetch_kind(owner, headers, kind) {
  let users = [];
  let page = 1;
  while (true) {
    let url = "https://api.github.com/users/" + owner + "/" + kind + "?per_page=100&page=" + str(page);
    let r = gh_get(url, headers);
    let up = int(get(r, "status", 0), 0);
    let body = str(get(r, "body", ""));
    if (up < 200 or up >= 300) { break; }
    let d = json(body);
    if (d == null or len(d) == 0) { break; }
    for (let u in d) {
      let login = s(get(u, "login", null));
      let nm = s(get(u, "name", null));
      if (nm == "") { nm = login; }
      push(users, {
        login: login,
        name: nm,
        avatar: s(get(u, "avatar_url", null)),
        url: s(get(u, "html_url", null)),
        type: s(get(u, "type", null)),
      });
    }
    if (len(d) < 100) { break; }
    page = page + 1;
    if (page > 10) { break; }
  }
  return users;
}

// talent-radar profit patterns (data/github/<owner>/radar.json, written by
// `make radar`): mutual high scorers classified by money pattern. Served
// as-is; the UI groups by `mode` and shows the per-person evidence note.
get "/api/radar", (req) => {
  let owner = owner_param(req);
  if (owner == "") { owner = default_owner(); }
  let raw = read_file("data/github/" + owner + "/radar.json");
  if (raw == null or raw == "") {
    return { status: 404, error: "no_radar", owner: owner, hint: "run: make radar" };
  }
  return json(raw);
};

get "/api/refresh", (req) => {
  let owner = owner_param(req);
  if (owner == "") { owner = default_owner(); }
  let t = int(now(), 0);
  let last = int(get(_refresh_at, owner, 0), 0);
  if (last != 0 and (t - last) < REFRESH_GAP_SEC) {
    return { ok: false, status: 429, wait: REFRESH_GAP_SEC - (t - last), err: "refresh too soon" };
  }
  let headers = { "Accept": "application/vnd.github+json", "User-Agent": "lume-talentlens" };
  // GH_ANALYZER_PAT is the Makefile alias of GH_TOKEN (env() masks names
  // containing TOKEN/API_KEY/SECRET/PASSWORD to keep untrusted scripts from
  // exfiltrating keys; the trusted live proxy reads the alias instead).
  let tok = env("GH_ANALYZER_PAT");
  if (tok != null and tok != "") { put(headers, "Authorization", "Bearer " + str(tok)); }

  let followers = refresh_fetch_kind(owner, headers, "followers");
  let following = refresh_fetch_kind(owner, headers, "following");
  if (len(followers) == 0 and len(following) == 0) {
    return { ok: false, status: 502, err: "upstream unreachable (network or rate limit)" };
  }
  // profile totals; fall back to fetched lengths when the profile call fails
  let prof = gh_get("https://api.github.com/users/" + owner, headers);
  let pd = json(str(get(prof, "body", "")));
  let tot = { followers: len(followers), following: len(following) };
  if (pd != null) {
    tot = { followers: int(get(pd, "followers", 0), 0), following: int(get(pd, "following", 0), 0) };
  }
  let people = {
    followers: followers,
    following: following,
    totals: tot,
    note: "refreshed via /api/refresh (server-side)",
  };
  // archive the previous snapshot before overwriting — /api/people_diff
  // compares current vs previous to show who followed/unfollowed since the
  // last refresh (no history on the very first refresh).
  let prev_raw = read_file("data/github/" + owner + "/people.json");
  if (prev_raw != null and prev_raw != "") {
    write_file("data/github/" + owner + "/people.prev.json", prev_raw);
  }
  write_file("data/github/" + owner + "/people.json", str(people));
  put(_refresh_at, owner, t);
  return { ok: true, status: 200, owner: owner, followers: len(followers), following: len(following) };
};

// people change diff: current people.json vs the archived people.prev.json
// (written by /api/refresh before overwriting). Shows who followed/unfollowed
// since the last refresh — the dashboard's "network change" view.
func login_list(rows) {
  let out = [];
  for (let r in rows) { push(out, str(get(r, "login", ""))); }
  return out;
}
func diff_login_lists(cur, prev) {
  let prev_set = {};
  for (let l in prev) { put(prev_set, l, 1); }
  let cur_set = {};
  for (let l in cur) { put(cur_set, l, 1); }
  let added = [];
  let gone = [];
  for (let l in cur) { if (get(prev_set, l, null) == null) { push(added, l); } }
  for (let l in prev) { if (get(cur_set, l, null) == null) { push(gone, l); } }
  return { added: added, gone: gone };
}

get "/api/people_diff", (req) => {
  let owner = owner_param(req);
  if (owner == "") { owner = default_owner(); }
  let cur = load_people(owner);
  if (cur == null) { return { ok: false, status: 404, err: "no people snapshot" }; }
  let prev_raw = read_file("data/github/" + owner + "/people.prev.json");
  let has_history = (prev_raw != null and prev_raw != "");
  let out = { ok: true, owner: owner, has_history: has_history, added: { followers: [], following: [] }, gone: { followers: [], following: [] } };
  if (has_history) {
    let prev = json(prev_raw);
    if (prev != null) {
      let cf = login_list(get(cur, "followers", []));
      let pf = login_list(get(prev, "followers", []));
      let df = diff_login_lists(cf, pf);
      put(out.added, "followers", df.added);
      put(out.gone, "followers", df.gone);
      let cg = login_list(get(cur, "following", []));
      let pg = login_list(get(prev, "following", []));
      let dg = diff_login_lists(cg, pg);
      put(out.added, "following", dg.added);
      put(out.gone, "following", dg.gone);
    }
  }
  return out;
};

// ------------------------------------------------ SSR pages
// "/" is owned by the React SPA (static, views dir). SSR pages use distinct
// paths and accept ?owner=; unknown/invalid owners fall back to the default.

func ssr_owner(req) {
  let o = owner_param(req);
  if (o == "") { return default_owner(); }
  return o;
}

func ssr_block(owner, lang) {
  // owner page with a hint card when its snapshot is missing
  return el("section", { class: "panel error" },
    el("h2", {}, ui.t(lang, "ssr_no_snap_title") + owner),
    el("p", {}, ui.t(lang, "ssr_no_snap_fetch")),
    el("code", {}, "OWNER=" + owner + " make fetch"),
    el("p", {}, ui.t(lang, "ssr_no_snap_cached")
      + str(reduce((acc, e) => acc + str(e) + " ", cached_owners(), ""))));
}

get "/overview", (req) => {
  let owner = ssr_owner(req);
  let lang = lang_param(req);
  let snap = load_snap(owner);
  if (snap == null) {
    return ui.page("Overview · " + owner, "home", [ssr_block(owner, lang)], lang);
  }
  let a = bundle(active_repos(snap), snap);
  let tot = a.totals;
  let body = [
    el("section", { class: "hero" },
            el("h1", {}, str(get(a.profile, "name", "")) + ui.t(lang, "ov_hero_1") + owner + ui.t(lang, "ov_hero_2")),
      el("p", {}, ui.t(lang, "ov_hero_3") + str(a.count) + ui.t(lang, "ov_hero_4")
        + a.fetched_at + ui.t(lang, "ov_hero_5"))),

    el("section", { class: "kpis" },
      ui.kpi(str(a.count), ui.t(lang, "ov_kpi_repos")),
      ui.kpi(str(a.non_fork_count), ui.t(lang, "ov_kpi_original")),
      ui.kpi(str(int(get(tot, "stars", 0))), ui.t(lang, "ov_kpi_stars")),
      ui.kpi(str(int(get(tot, "forks", 0))), ui.t(lang, "ov_kpi_forks"))),

    el("section", { class: "grid" },
      el("div", { class: "panel" },
        el("h2", {}, ui.t(lang, "ov_langs")),
        el("div", { class: "bars" }, ui.bars(a.languages))),
      el("div", { class: "panel" },
        el("h2", {}, ui.t(lang, "ov_recency")),
        el("div", { class: "bars" }, ui.bars(a.recency)))),

    el("section", { class: "panel" },
      el("h2", {}, ui.t(lang, "ov_top10")),
      el("ol", { class: "top-list" }, top_list(a.top_by_stars, lang))),

    el("section", { class: "links" },
      el("a", { class: "btn", href: "/repos?lang=" + lang }, ui.t(lang, "ov_browse")),
      el("a", { class: "btn", href: "/api?lang=" + lang }, ui.t(lang, "ov_api")),
      el("a", { class: "btn", href: "/chat?lang=" + lang }, ui.t(lang, "ov_chat"))),
  ];
  return ui.page("Overview · " + owner, "home", body, lang);
};

func top_list(rows, lang) {
  let out = [];
  let i = 0;
  for (let r in rows) {
    push(out, ui.repo_row(r, i + 1, lang));
    i = i + 1;
  }
  return out;
}

// "owner's repositories (110 total)" / "owner 的仓库（110 个）"
func repos_title(lang, owner, n) {
  return owner + ui.t(lang, "repos_title_1") + str(n) + ui.t(lang, "repos_title_2");
}

get "/repos", (req) => {
  let owner = ssr_owner(req);
  let lang = lang_param(req);
